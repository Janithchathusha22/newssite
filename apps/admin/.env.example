# Leave empty for same-origin /api (Vite proxies it to localhost:5000).
# Set an absolute URL only when the API is hosted on a different domain.
VITE_ADMIN_API_URL=
# Enables the explicit browser-only demo button. Use false for production.
VITE_DEMO_MODE=true

# Optional: public site base URL used by the preview/published links.
VITE_PUBLIC_SITE_URL=http://localhost:5173
