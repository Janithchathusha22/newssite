# Reliable production scheduler (hourly with a short failure retry).
AUTO_SYNC_ENABLED=true
AUTO_SYNC_RUN_ON_START=true
AUTO_SYNC_INTERVAL_MINUTES=60
AUTO_SYNC_RETRY_MINUTES=15
AUTO_SYNC_MAX_RUNTIME_MINUTES=120
SYNC_FRESHNESS_HOURS=26

# Set a long random value only when an external hosting cron calls
# POST /api/sync/run with Authorization: Bearer <token>.
SYNC_TRIGGER_TOKEN=

# The normal unified run already includes Daily FT's current RSS feeds.
SCRAPE_RSS_ENABLED=true
SCRAPE_FT_ENABLED=false
HYDRATE_MISSING_IMAGES=false
PIPELINE_LOCK_STALE_MINUTES=130
MULTI_SITE_TARGET=150
MULTI_SITE_MAX_ARTICLES=240
SOURCE_REGISTRY_TIMEOUT_SECONDS=20

# AI enrichment is optional and must never block daily collection.
AI_ENABLED=false
AI_MAX_ARTICLES=30
AI_REQUEST_DELAY_SECONDS=10
GROQ_API_KEY=
# Strict JSON Schema is available for Groq's documented GPT-OSS models.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_INPUT_MAX_CHARS=12000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-host-secret
SUPABASE_SYNC_ENABLED=true
# Make the scheduler report failure/retry when database delivery is not complete.
SUPABASE_SYNC_REQUIRED=true
# auto = Supabase when the migration is reachable, labelled local demo otherwise.
# Production defaults to supabase even when this line is omitted.
EDITORIAL_BACKEND=auto

# Editorial API / separate React applications.
ADMIN_EMAIL=editor@example.com
# Prefer a server-side scrypt hash: scrypt$<salt-hex>$<digest-hex>.
# ADMIN_PASSWORD remains supported for local tests only.
ADMIN_PASSWORD_HASH=replace-with-a-scrypt-password-hash
ADMIN_DISPLAY_NAME=Newsroom Editor
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
PREVIEW_TOKEN_SECRET=replace-with-a-different-32-character-secret
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=5000
# Keep the old direct-feed prototype private in production. The React public
# app reads only /api/public/* approved projections.
LEGACY_PUBLIC_API_ENABLED=false
